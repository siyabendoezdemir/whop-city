# Whop City — local environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# No real key, secret, or business identifier belongs in this file or in any
# other tracked file.

# ---------------------------------------------------------------------------
# Whop API boundary
# ---------------------------------------------------------------------------

# The dated API version every request pins to. Whop serves pre-versioning
# behaviour when this is absent, so it is never optional.
WHOP_API_VERSION=2026-09-02-2

# Production. The sandbox host is https://sandbox-api.whop.com/api/v1, but the
# sandbox does not support apps or OAuth — see docs/whop-permission-matrix.md.
WHOP_API_BASE_URL=https://api.whop.com/api/v1

# ---------------------------------------------------------------------------
# OAuth app (Sign in with Whop)
# ---------------------------------------------------------------------------

WHOP_APP_ID=app_xxxxxxxxxxxx
WHOP_CLIENT_SECRET=
WHOP_OAUTH_REDIRECT_URI=http://localhost:3000/auth/whop/callback

# ---------------------------------------------------------------------------
# Task 1 capability probe
# ---------------------------------------------------------------------------

# The dedicated throwaway test business. Never a business with real customers.
WHOP_TEST_BUSINESS_ID=biz_xxxxxxxxxxxx

# A user OAuth access token for that business, or a scoped account API key.
WHOP_TEST_ACCESS_TOKEN=

# Set to 1 only when you intend the probe to create one real hidden draft
# product in the test business.
WHOP_PROBE_ALLOW_WRITES=0

# Distinguishes probe runs so a deliberate second run is not deduped.
WHOP_PROBE_NONCE=local-001

# ---------------------------------------------------------------------------
# Test gates
# ---------------------------------------------------------------------------

# Live tests that need network but no secrets.
WHOP_LIVE_UNAUTH=0

# Live tests that need the credentials above.
WHOP_LIVE_SANDBOX=0

# ---------------------------------------------------------------------------
# Webhooks (Task 5)
# ---------------------------------------------------------------------------

# Returned once by POST /webhooks and never readable again by an OAuth caller.
# Capture it at creation and store it encrypted.
WHOP_WEBHOOK_SECRET=

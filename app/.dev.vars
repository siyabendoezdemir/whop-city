# Local-only variables for `vite dev` and `vite preview`.
#
# Wrangler reads this file for the local worker and never uploads it, which is
# exactly why the fixture switch lives here: a deployed City has no
# CITY_FIXTURES, so it can never serve invented business state.
#
# No secrets belong in this file. City holds no credential in any environment.
CITY_FIXTURES=1
